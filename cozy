#!/usr/bin/env bash
# Cozy launcher - eager-loads wakeword + STT + LLM + TTS, then starts the
# voice loop. Designed to feel instant on first wake word.
#
# Usage:
#   cozy                 # full voice loop (default)
#   cozy --calibrate     # 30s wake score log
#   cozy --no-wake       # voice loop without wake gate
#   cozy --no-tts        # log replies but don't speak
#   cozy --fast-harness  # use the optimized harness (RAM + context)
#   cozy --threshold 0.5 # custom wake threshold
#   cozy --status        # which models are on disk
#   cozy --stop          # kill any running cozy process

set -euo pipefail

# Resolve symlinks so ~/.local/bin/cozy still locates the repository.
SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || realpath "$0")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
PY="$ROOT/assistant/.venv/bin/python"

# Convenience symlinks installed by install-global.sh.
case "$(basename "$0")" in
  cozystop) set -- --stop ;;
  cozystatus) set -- --status ;;
esac

LLM_BASE="${COZY_LLM_BASE:-$ROOT/assistant/model/cozy-llm-v1}"
LLM_ADAPTER="${COZY_LLM_ADAPTER:-$ROOT/assistant/model/cozy-llm-v1-adapter}"

case "${1:-}" in
  "" | --tui | --no-wake | --no-tts | --threshold)
    # Launch the OpenTUI interface by default.
    if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
      echo "Node.js 26.4+ and npm are required for the Cozy OpenTUI interface." >&2
      exit 1
    fi
    NODE_VERSION="$(node -p 'process.versions.node' 2>/dev/null || echo "")"
    NODE_MAJOR="${NODE_VERSION%%.*}"
    NODE_REST="${NODE_VERSION#*.}"
    NODE_MINOR="${NODE_REST%%.*}"
    if ! [[ "$NODE_MAJOR" =~ ^[0-9]+$ && "$NODE_MINOR" =~ ^[0-9]+$ ]] || (( NODE_MAJOR < 26 || (NODE_MAJOR == 26 && NODE_MINOR < 4) )); then
      echo "Cozy OpenTUI needs Node.js 26.4 or newer (found $(node --version))." >&2
      exit 1
    fi
    if [[ ! -t 1 ]]; then
      echo "Cozy needs an interactive terminal (stdout is not a TTY)." >&2
      echo "Run it directly in a terminal, e.g.:  bash cozy" >&2
      exit 1
    fi
    if [ ! -d "$ROOT/assistant/tui-node/node_modules/@opentui/core" ]; then
      echo "Installing tui-node deps..." >&2
      (cd "$ROOT/assistant/tui-node" && npm ci --silent) || exit 1
    fi
    exec node --experimental-ffi "$ROOT/assistant/tui-node/src/index.ts" "$@"
    ;;
  --status)
    echo "Cozy model status:"
    STT_CT2="$ROOT/stt-finetune/output/cozy_stt_v1_ct2_int8/model.bin"
    STT_HF="$ROOT/stt-finetune/output/hf_finetuned/pytorch_model.bin"
    if [[ -f "$ROOT/stt-finetune/output/cozy_stt_v1.2_ct2_int8/model.bin" ]]; then
      STT_CT2="$ROOT/stt-finetune/output/cozy_stt_v1.2_ct2_int8/model.bin"
    fi
    if [[ -f "$ROOT/stt-finetune/output/hf_finetuned_v1.2/model.safetensors" ]]; then
      STT_HF="$ROOT/stt-finetune/output/hf_finetuned_v1.2/model.safetensors"
    fi
    for p in \
      "$ROOT/wakeword/output/hey_cozy/hey_cozy.onnx" \
      "$STT_CT2" \
      "$STT_HF" \
      "$LLM_BASE" \
      "$LLM_ADAPTER/adapter_model.safetensors"; do
      if [[ -e "$p" ]]; then
        sz=$(du -h "$p" | cut -f1)
        printf "  OK   %-72s (%s)\n" "$p" "$sz"
      else
        printf "  MISS %s\n" "$p"
      fi
    done
    exit 0
    ;;
  --stop)
    stopped=0
    for pattern in "$ROOT/assistant/runtime.py" "$ROOT/assistant/tui-node/src/index.ts"; do
      if pkill -TERM -f -- "$pattern" 2>/dev/null; then
        stopped=1
      fi
    done
    if [[ "$stopped" -eq 1 ]]; then echo "cozy stopped"; else echo "no cozy process"; fi
    exit 0
    ;;
  --help|-h)
    sed -n '2,18p' "$0"
    exit 0
    ;;
esac

# Sanity check the critical paths. STT models are loaded lazily by
# CozySTT and are not required to launch the runtime -- only the wake
# word and the LLM base are needed at startup.
MISSING=0
for p in \
  "$ROOT/assistant/.venv/bin/python" \
  "$ROOT/wakeword/output/hey_cozy/hey_cozy.onnx" \
  "$LLM_BASE"; do
  if [[ ! -e "$p" ]]; then
    echo "Missing: $p" >&2
    MISSING=1
  fi
done
# STT is optional at launch; warn but don't fail.
for p in \
  "$ROOT/stt-finetune/output/cozy_stt_v1_ct2_int8" \
  "$ROOT/stt-finetune/output/hf_finetuned" \
  "$LLM_ADAPTER"; do
  if [[ ! -e "$p" ]]; then
    echo "Note (optional, lazy-loaded): $p" >&2
  fi
done
if [[ "$MISSING" -ne 0 ]]; then
    echo "Run: bash setup.sh" >&2
    exit 1
fi

# Note: we used to do a `python -c "import kokoro"` check here. That
# takes 16s on first run because Kokoro downloads its model. Skip the
# check - the TTS plugin loads lazily on first speak(), and the
# runtime emits a warning if Kokoro is missing.

# Make the venv site-packages importable from the script.
export PYTHONPATH="$ROOT/assistant${PYTHONPATH:+:$PYTHONPATH}"

cat <<'BANNER'
  ╔══════════════════════════════════════════════════════════╗
  ║  🎙️  Cozy voice assistant                              ║
  ║     wakeword  → STT  → LLM  → executor  → TTS          ║
  ╚══════════════════════════════════════════════════════════╝
BANNER

# Pass through all CLI flags to runtime.py. The runtime loads all four
# models, then enters the wake loop.
exec "$PY" "$ROOT/assistant/runtime.py" "$@"
