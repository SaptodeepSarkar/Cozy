#!/usr/bin/env bash
# Cozy is a thin voice-first launcher around the Hermes Agent desktop.
set -euo pipefail

SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || realpath "$0")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
HERMES="$ROOT/hermes-agent/hermes"

if [[ "$(basename "$0")" == cozystatus ]]; then
  set -- --status "$@"
fi

if [[ ! -f "$HERMES" ]]; then
  echo "Hermes source is missing. Run: git submodule update --init --recursive hermes-agent" >&2
  exit 1
fi

case "${1:-}" in
  --help|-h)
    cat <<'EOF'
Usage: cozy [--desktop|--cli|--status|--help] [Hermes arguments...]

  cozy             Open the Cozy-branded Hermes desktop (voice-first).
  cozy --cli       Start Hermes chat with computer-use tools enabled.
  cozy --status    Run Hermes diagnostics.
  cozy --desktop   Explicitly open the desktop.
EOF
    ;;
  --status)
    exec "$HERMES" doctor "${@:2}"
    ;;
  --cli)
    shift
    exec "$HERMES" -t computer_use chat "$@"
    ;;
  --desktop)
    shift
    exec "$HERMES" desktop "$@"
    ;;
  *)
    exec "$HERMES" desktop "$@"
    ;;
esac
