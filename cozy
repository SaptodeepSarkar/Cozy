#!/usr/bin/env bash
# Cozy is the voice-first desktop assistant, powered by the Hermes runtime.
set -euo pipefail

SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || realpath "$0")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
HERMES="$ROOT/hermes-agent/hermes"
export COZY_BRANDED=1

# The desktop app otherwise probes Hermes' separate default install location
# (~/.hermes/hermes-agent). Cozy's setup owns the runtime under this checkout,
# so point Electron at that already-installed Cozy backend before it considers
# its generic first-run install/connect flow.
if [[ -z "${HERMES_DESKTOP_HERMES:-}" ]]; then
  COZY_RUNTIME="$ROOT/hermes-agent/.hermes/bin/hermes"
  if [[ ! -x "$COZY_RUNTIME" ]]; then COZY_RUNTIME="$HERMES"; fi
  export HERMES_DESKTOP_HERMES="$COZY_RUNTIME"
fi

if [[ "$(basename "$0")" == cozystatus ]]; then
  set -- --status "$@"
fi

if [[ ! -f "$HERMES" ]]; then
  echo "Hermes source is missing. Run: git submodule update --init --recursive hermes-agent" >&2
  exit 1
fi

case "${1:-}" in
  --help|-h)
    cat <<'EOF'
Usage: cozy [--desktop|--cli|--status|--help] [Cozy options...]

  cozy             Open the Cozy desktop assistant.
  cozy --cli       Talk to Cozy in the terminal with computer-use tools enabled.
  cozy --status    Check Cozy's runtime and model setup.
  cozy --desktop   Explicitly open the desktop.
EOF
    ;;
  --status)
    exec "$HERMES" doctor "${@:2}"
    ;;
  --cli)
    shift
    exec "$HERMES" -t computer_use chat "$@"
    ;;
  --desktop)
    shift
    exec "$HERMES" desktop "$@"
    ;;
  *)
    exec "$HERMES" desktop "$@"
    ;;
esac
