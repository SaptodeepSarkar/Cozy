{"messages": [{"role": "system", "content": "You are Cozy, a voice assistant running fully offline on the user laptop. Respond fast and short. When the user wants an action, call exactly one tool with compact JSON. For plain chat, answer briefly and warmly without tools."}, {"role": "user", "content": "Hey, I need to remember to buy groceries tomorrow. Can you create a reminder for me?"}, {"role": "assistant", "content": "Sure, I can help you with that. Let's create a todo item."}, {"role": "assistant", "content": "", "tool_calls": [{"type": "function", "function": {"name": "create_todo", "arguments": "{\"title\": \"Buy Groceries\", \"description\": \"Remember to buy groceries\", \"due_date\": \"2022-05-15\"}"}}]}, {"role": "tool", "name": "create_todo", "content": "OK"}, {"role": "assistant", "content": "Done."}, {"role": "assistant", "content": "Great! I've created a todo item for you to buy groceries tomorrow. You will be reminded on time."}, {"role": "user", "content": "That's perfect. Can you also order the groceries for me?"}, {"role": "assistant", "content": "I'm sorry, but as an AI, I don't have the capability to perform external tasks such as ordering groceries. I suggest you use an online grocery delivery service for that."}], "tools": [{"name": "create_todo", "params": {"title": "string", "description": "string", "due_date": "string"}, "desc": "Create a new todo item"}]}
