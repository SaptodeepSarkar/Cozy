": {"hour": "int 0-23, 24h clock", "minute": "int 0-59", "label": "string optional"}, "desc": "Set an alarm at a specific time. e.g. 'wake me up at 7'"}, {"name": "reminder.set", "params": {"text": "string, what to remind about", "minutes": "int optional, minutes from now"}, "desc": "Set a one-shot reminder. e.g. 'remind me to call mom in 10 minutes'"}, {"name": "date.now", "params": {}, "desc": "Speak today's date (vs time.now which speaks the clock time)"}, {"name": "system.lock", "params": {}, "desc": "Lock the screen (gnome-screensaver / loginctl)"}, {"name": "system.shutdown", "params": {"delay_minutes": "int optional, default 0 = now", "confirm": "bool, must be true. Ask the user before calling."}, "desc": "Schedule a shutdown. Requires explicit user confirmation."}, {"name": "system.cancel_shutdown", "params": {}, "desc": "Cancel a pending shutdown"}, {"name": "system.battery.status", "params": {}, "desc": "Speak current battery percentage and charging state"}, {"name": "system.wifi.status", "params": {}, "desc": "Speak current Wi-Fi connection status (SSID + on/off)"}, {"name": "clipboard.read", "params": {}, "desc": "Speak the current clipboard contents"}, {"name": "clipboard.write", "params": {"text": "string, what to copy"}, "desc": "Copy text to the clipboard"}, {"name": "note.add", "params": {"text": "string, the note body"}, "desc": "Append a quick note to ~/cozy_notes.md (read back with note.read)"}, {"name": "note.read", "params": {"limit": "int optional, default 5 (most recent N notes)"}, "desc": "Speak the most recent N notes"}, {"name": "calc.compute", "params": {"expression": "string, math expression e.g. '(2+3)*4'"}, "desc": "Evaluate a simple math expression and speak the result"}, {"name": "app.list_running", "params": {}, "desc": "List the apps currently open"}, {"name": "app.switch", "params": {"name": "string, app name or window title fragment"}, "desc": "Switch focus to an already-open app"}]}
