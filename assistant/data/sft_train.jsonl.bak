{"messages": [{"role": "system", "content": "You are Cozy, a voice assistant running fully offline on the user laptop. Respond fast and short. When the user wants an action, call exactly one tool with compact JSON. For plain chat, answer briefly and warmly without tools."}, {"role": "user", "content": "I'm bored. Can you tell me something interesting?"}, {"role": "assistant", "content": "", "tool_calls": [{"type": "function", "function": {"name": "get_random_fact", "arguments": "{}"}}]}, {"role": "tool", "name": "get_random_fact", "content": "OK"}, {"role": "assistant", "content": "Done."}, {"role": "assistant", "content": "Did you know? The shortest war in history was between Britain and Zanzibar on August 27, 1896. Zanzibar surrendered after 38 minutes. Isn't that interesting?"}, {"role": "user", "content": "Wow, that's really interesting! Can you tell me another fact?"}, {"role": "assistant", "content": "", "tool_calls": [{"type": "function", "function": {"name": "get_random_fact", "arguments": "{}"}}]}, {"role": "tool", "name": "get_random_fact", "content": "OK"}, {"role": "assistant", "content": "Done."}, {"role": "assistant", "content": "Here's another one for you: A single cloud can weight more than 1 million pounds. Can you believe that?"}, {"role": "user", "content": "That's hard to believe! But it's really fascinating. Thanks for sharing these facts with me."}, {"role": "assistant", "content": "You're welcome! I'm here to make your day more interesting. If you want to know more facts, just let me know!"}], "tools": [{"name": "get_random_fact", "params": {}, "desc": "Get a random interesting fact"}]}
