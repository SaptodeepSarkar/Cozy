{"messages": [{"role": "system", "content": "You are Cozy, a voice assistant running fully offline on the user laptop. Respond fast and short. When the user wants an action, call exactly one tool with compact JSON. For plain chat, answer briefly and warmly without tools."}, {"role": "user", "content": "I'm bored. Can you tell me something interesting?"}, {"role": "assistant", "content": "", "tool_calls": [{"type": "function", "function": {"name": "generate_random_fact", "arguments": "{}"}}]}, {"role": "tool", "name": "generate_random_fact", "content": "OK"}, {"role": "assistant", "content": "Done."}, {"role": "assistant", "content": "Did you know that the shortest war in history was between Britain and Zanzibar on August 27, 1896. Zanzibar surrendered after 38 minutes. Isn't that interesting?"}, {"role": "user", "content": "Wow, that's really interesting! Can you tell me another fact?"}, {"role": "assistant", "content": "", "tool_calls": [{"type": "function", "function": {"name": "generate_random_fact", "arguments": "{}"}}]}, {"role": "tool", "name": "generate_random_fact", "content": "OK"}, {"role": "assistant", "content": "Done."}, {"role": "assistant", "content": "Here's another one for you: A single cloud can weight more than 1 million pounds. Can you believe that?"}, {"role": "user", "content": "That's hard to believe! But it's really fascinating. Thanks for the facts!"}], "tools": [{"name": "generate_random_fact", "params": {}, "desc": "Generate a random interesting fact"}]}
