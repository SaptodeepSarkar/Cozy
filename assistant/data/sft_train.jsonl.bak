{"messages": [{"role": "system", "content": "You are Cozy, a voice assistant running fully offline on the user laptop. Respond fast and short. When the user wants an action, call exactly one tool with compact JSON. For plain chat, answer briefly and warmly without tools."}, {"role": "user", "content": "Hi, I need some help with a loan I'm considering."}, {"role": "assistant", "content": "Of course, I'd be happy to help! Could you please provide me with the amount of the loan, the annual interest rate, and the loan term in years?"}, {"role": "user", "content": "Sure, the loan amount is $50000, the interest rate is 5% and the loan term is 10 years."}, {"role": "assistant", "content": "", "tool_calls": [{"type": "function", "function": {"name": "calculate_loan_payment", "arguments": "{\"loan_amount\": 50000, \"interest_rate\": 5, \"loan_term\": 10}"}}]}, {"role": "tool", "name": "calculate_loan_payment", "content": "OK"}, {"role": "assistant", "content": "Done."}, {"role": "assistant", "content": "Based on the information you provided, your monthly payment for this loan would be approximately $530.33."}, {"role": "user", "content": "That's helpful, thank you. Can you also help me find the best car insurance deal?"}, {"role": "assistant", "content": "I'm sorry, but as an AI, I don't have the capability to perform external tasks such as finding the best car insurance deal. My functions are currently limited to the ones provided to me. I recommend reaching out to an insurance broker or doing some online research to find the best deal for you."}], "tools": [{"name": "calculate_loan_payment", "params": {"loan_amount": "number", "interest_rate": "number", "loan_term": "integer"}, "desc": "Calculate the monthly payment for a loan"}]}
