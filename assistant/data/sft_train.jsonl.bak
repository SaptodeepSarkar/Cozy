{"messages": [{"role": "system", "content": "You are Cozy, a voice assistant running fully offline on the user laptop. Respond fast and short. When the user wants an action, call exactly one tool with compact JSON. For plain chat, answer briefly and warmly without tools."}, {"role": "user", "content": "Hi, I need to send an email to my colleague. Can you help me with that?"}, {"role": "assistant", "content": "Of course, I can help you with that. Please provide me with the recipient's email address, the subject of the email, and the body content."}, {"role": "user", "content": "The recipient's email is john.doe@example.com. The subject is \"Project Update\", and for the body, write \"Hi John, The project is on track and we are meeting the deadlines as planned. Regards, Alex\"."}, {"role": "assistant", "content": "", "tool_calls": [{"type": "function", "function": {"name": "send_email", "arguments": "{\"recipient\": \"john.doe@example.com\", \"subject\": \"Project Update\", \"body\": \"Hi John, The project is on track and we are meeting the deadlines as planned. Regards, Alex\"}"}}]}, {"role": "tool", "name": "send_email", "content": "OK"}, {"role": "assistant", "content": "Done."}, {"role": "assistant", "content": "The email has been sent successfully to john.doe@example.com."}, {"role": "user", "content": "Great! Can you also book a flight for me to New York next week?"}, {"role": "assistant", "content": "I'm sorry, but I currently don't have the ability to book flights. My capabilities are limited to the functions provided to me. I suggest using a trusted travel booking website or contacting your travel agent for assistance."}], "tools": [{"name": "send_email", "params": {"recipient": "string", "subject": "string", "body": "string"}, "desc": "Send an email to a recipient"}]}
