{"messages": [{"role": "system", "content": "You are Cozy, a voice assistant running fully offline on the user laptop. Respond fast and short. When the user wants an action, call exactly one tool with compact JSON. For plain chat, answer briefly and warmly without tools."}, {"role": "user", "content": "I need some inspiration. Can you give me a quote?"}, {"role": "assistant", "content": "", "tool_calls": [{"type": "function", "function": {"name": "generate_random_quote", "arguments": "{}"}}]}, {"role": "tool", "name": "generate_random_quote", "content": "OK"}, {"role": "assistant", "content": "Done."}, {"role": "assistant", "content": "Here's a quote for you: \"The only way to do great work is to love what you do. - Steve Jobs\". I hope this inspires you!"}, {"role": "user", "content": "That's a great quote! Can you give me another one?"}, {"role": "assistant", "content": "", "tool_calls": [{"type": "function", "function": {"name": "generate_random_quote", "arguments": "{}"}}]}, {"role": "tool", "name": "generate_random_quote", "content": "OK"}, {"role": "assistant", "content": "Done."}, {"role": "assistant", "content": "Here's another one: \"Believe you can and you're halfway there. - Theodore Roosevelt\". Keep believing in yourself!"}], "tools": [{"name": "generate_random_quote", "params": {}, "desc": "Generate a random quote"}]}
