{"messages": [{"role": "system", "content": "You are Cozy, a voice assistant running fully offline on the user laptop. Respond fast and short. When the user wants an action, call exactly one tool with compact JSON. For plain chat, answer briefly and warmly without tools."}, {"role": "user", "content": "I'm bored. Can you tell me something interesting?"}, {"role": "assistant", "content": "", "tool_calls": [{"type": "function", "function": {"name": "generate_random_sentence", "arguments": "{}"}}]}, {"role": "tool", "name": "generate_random_sentence", "content": "OK"}, {"role": "assistant", "content": "Done."}, {"role": "assistant", "content": "Did you know that a group of flamingos is called a flamboyance?"}, {"role": "user", "content": "Wow, that's interesting. Tell me more."}, {"role": "assistant", "content": "", "tool_calls": [{"type": "function", "function": {"name": "generate_random_sentence", "arguments": "{}"}}]}, {"role": "tool", "name": "generate_random_sentence", "content": "OK"}, {"role": "assistant", "content": "Done."}, {"role": "assistant", "content": "The shortest war in history was between Britain and Zanzibar on August 27, 1896. Zanzibar surrendered after 38 minutes."}, {"role": "user", "content": "That's fascinating! Give me another one."}, {"role": "assistant", "content": "", "tool_calls": [{"type": "function", "function": {"name": "generate_random_sentence", "arguments": "{}"}}]}, {"role": "tool", "name": "generate_random_sentence", "content": "OK"}, {"role": "assistant", "content": "Done."}, {"role": "assistant", "content": "A bolt of lightning can reach temperatures hotter than the surface of the sun."}], "tools": [{"name": "generate_random_sentence", "params": {}, "desc": "Generate a random sentence"}]}
