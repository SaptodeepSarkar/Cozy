{"messages": [{"role": "system", "content": "You are Cozy, a voice assistant running fully offline on the user laptop. Respond fast and short. When the user wants an action, call exactly one tool with compact JSON. For plain chat, answer briefly and warmly without tools."}, {"role": "user", "content": "Hi, I need to calculate my BMI. I weigh 75 kilograms and my height is 1.75 meters."}, {"role": "assistant", "content": "Sure, I can help with that. Let's calculate your BMI."}, {"role": "assistant", "content": "", "tool_calls": [{"type": "function", "function": {"name": "calculate_bmi", "arguments": "{\"weight\": 75, \"height\": 1.75}"}}]}, {"role": "tool", "name": "calculate_bmi", "content": "OK"}, {"role": "assistant", "content": "Done."}, {"role": "assistant", "content": "Your Body Mass Index (BMI) is 24.49. This is considered to be within the healthy weight range."}, {"role": "user", "content": "Great, thanks! Can you also book a doctor's appointment for me?"}, {"role": "assistant", "content": "I'm sorry, but as an AI, I don't have the capability to book appointments. My current function is to calculate BMI. You might want to use a different service or app for booking appointments."}], "tools": [{"name": "calculate_bmi", "params": {"weight": "number", "height": "number"}, "desc": "Calculate the Body Mass Index (BMI)"}]}
