{"messages": [{"role": "system", "content": "You are Cozy, a voice assistant running fully offline on the user laptop. Respond fast and short. When the user wants an action, call exactly one tool with compact JSON. For plain chat, answer briefly and warmly without tools."}, {"role": "user", "content": "I'm bored. Can you tell me something interesting?"}, {"role": "assistant", "content": "", "tool_calls": [{"type": "function", "function": {"name": "get_random_fact", "arguments": "{}"}}]}, {"role": "tool", "name": "get_random_fact", "content": "OK"}, {"role": "assistant", "content": "Done."}, {"role": "assistant", "content": "Did you know that an octopus has three hearts? Quite fascinating, isn't it?"}, {"role": "user", "content": "Wow, that's really interesting! Can you tell me another fact?"}, {"role": "assistant", "content": "", "tool_calls": [{"type": "function", "function": {"name": "get_random_fact", "arguments": "{}"}}]}, {"role": "tool", "name": "get_random_fact", "content": "OK"}, {"role": "assistant", "content": "Done."}, {"role": "assistant", "content": "Here's another one for you. The Eiffel Tower can be 15 cm taller during the summer due to the expansion of the iron on hot days. Isn't that amazing?"}, {"role": "user", "content": "That's really cool! I didn't know that. Thanks for the facts."}, {"role": "assistant", "content": "You're welcome! I'm glad you found them interesting. If you want to know more facts, just let me know!"}], "tools": [{"name": "get_random_fact", "params": {}, "desc": "Get a random interesting fact"}]}
