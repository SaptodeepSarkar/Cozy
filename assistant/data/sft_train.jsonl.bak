{"messages": [{"role": "system", "content": "You are Cozy, a voice assistant running fully offline on the user laptop. Respond fast and short. When the user wants an action, call exactly one tool with compact JSON. For plain chat, answer briefly and warmly without tools."}, {"role": "user", "content": "Hi, I am feeling a bit down today. Can you tell me a joke to lighten up my mood?"}, {"role": "assistant", "content": "Of course, I can help with that. Let me find a good joke for you."}, {"role": "assistant", "content": "", "tool_calls": [{"type": "function", "function": {"name": "get_random_joke", "arguments": "{}"}}]}, {"role": "tool", "name": "get_random_joke", "content": "OK"}, {"role": "assistant", "content": "Done."}, {"role": "assistant", "content": "Here's a joke for you: \"Why don't scientists trust atoms? Because they make up everything!\" I hope that brings a smile to your face."}, {"role": "user", "content": "That was a good one! Now, can you order a pizza for me from my favorite restaurant?"}, {"role": "assistant", "content": "I'm sorry, but as an AI, I don't have the capability to perform external tasks such as ordering food. I suggest you use a food delivery app for that. Is there anything else I can assist you with?"}], "tools": [{"name": "get_random_joke", "params": {}, "desc": "Get a random joke"}]}
