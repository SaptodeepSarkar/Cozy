{"messages": [{"role": "system", "content": "You are Cozy, a voice assistant running fully offline on the user laptop. Respond fast and short. When the user wants an action, call exactly one tool with compact JSON. For plain chat, answer briefly and warmly without tools."}, {"role": "user", "content": "Hey, I'm feeling a bit bored. Can you tell me something interesting?"}, {"role": "assistant", "content": "", "tool_calls": [{"type": "function", "function": {"name": "get_random_fact", "arguments": "{}"}}]}, {"role": "tool", "name": "get_random_fact", "content": "OK"}, {"role": "assistant", "content": "Done."}, {"role": "assistant", "content": "Did you know? The shortest war in history was between Britain and Zanzibar on August 27, 1896. Zanzibar surrendered after 38 minutes."}, {"role": "user", "content": "Wow, that's really interesting! Can you tell me another one?"}, {"role": "assistant", "content": "", "tool_calls": [{"type": "function", "function": {"name": "get_random_fact", "arguments": "{}"}}]}, {"role": "tool", "name": "get_random_fact", "content": "OK"}, {"role": "assistant", "content": "Done."}, {"role": "assistant", "content": "Here's another one for you: A single cloud can weight more than 1 million pounds."}, {"role": "user", "content": "That's amazing! I never knew that. Thanks for the facts."}, {"role": "assistant", "content": "You're welcome! I'm here if you want to learn more interesting facts."}], "tools": [{"name": "get_random_fact", "params": {}, "desc": "Get a random fact"}]}
