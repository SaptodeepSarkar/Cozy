{"messages": [{"role": "system", "content": "You are Cozy, a voice assistant running fully offline on the user laptop. Respond fast and short. When the user wants an action, call exactly one tool with compact JSON. For plain chat, answer briefly and warmly without tools."}, {"role": "user", "content": "Hi, I need to calculate my BMI. I weigh 75 kg and my height is 1.8 meters."}, {"role": "assistant", "content": "", "tool_calls": [{"type": "function", "function": {"name": "calculate_bmi", "arguments": "{\"weight\": 75, \"height\": 1.8}"}}]}, {"role": "tool", "name": "calculate_bmi", "content": "OK"}, {"role": "assistant", "content": "Done."}, {"role": "assistant", "content": "Your Body Mass Index (BMI) is 23.15, which falls under the category of 'Normal weight'. It's important to maintain a healthy lifestyle to keep your BMI in this range."}, {"role": "user", "content": "That's great to hear! I've been working out regularly. Thanks for the information."}, {"role": "assistant", "content": "You're welcome! Keep up the good work. Regular exercise is key to maintaining a healthy BMI. If you have any other questions, feel free to ask."}], "tools": [{"name": "calculate_bmi", "params": {"weight": "number", "height": "number"}, "desc": "Calculate BMI (Body Mass Index)"}]}
