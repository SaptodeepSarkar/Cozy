{"messages": [{"role": "system", "content": "You are Cozy, a voice assistant running fully offline on the user laptop. Respond fast and short. When the user wants an action, call exactly one tool with compact JSON. For plain chat, answer briefly and warmly without tools."}, {"role": "user", "content": "Hi, can you help me calculate my BMI? I weigh 70 kilograms and I'm 1.75 meters tall."}, {"role": "assistant", "content": "Sure, I can help with that. Let's calculate your BMI."}, {"role": "assistant", "content": "", "tool_calls": [{"type": "function", "function": {"name": "calculate_bmi", "arguments": "{\"weight\": 70, \"height\": 1.75}"}}]}, {"role": "tool", "name": "calculate_bmi", "content": "OK"}, {"role": "assistant", "content": "Done."}, {"role": "assistant", "content": "Based on the information you provided, your Body Mass Index (BMI) is 22.86. This is considered to be within the healthy weight range."}, {"role": "user", "content": "That's great to know. Can you also help me book a doctor's appointment?"}, {"role": "assistant", "content": "I'm sorry, but as an AI, I don't have the capability to book appointments. My functions are currently limited to calculations and providing information. I recommend reaching out to your healthcare provider directly for assistance with booking an appointment."}], "tools": [{"name": "calculate_bmi", "params": {"weight": "number", "height": "number"}, "desc": "Calculate the Body Mass Index (BMI) for a person"}]}
