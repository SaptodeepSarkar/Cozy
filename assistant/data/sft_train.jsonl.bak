 24h clock", "minute": "int 0-59", "label": "string optional"}, "desc": "Set an alarm at a specific time. e.g. 'wake me up at 7'"}, {"name": "reminder.set", "params": {"text": "string, what to remind about", "minutes": "int optional, minutes from now"}, "desc": "Set a one-shot reminder. e.g. 'remind me to call mom in 10 minutes'"}, {"name": "date.now", "params": {}, "desc": "Speak today's date (vs time.now which speaks the clock time)"}, {"name": "system.lock", "params": {}, "desc": "Lock the screen (gnome-screensaver / loginctl)"}, {"name": "system.shutdown", "params": {"delay_minutes": "int optional, default 0 = now", "confirm": "bool, must be true. Ask the user before calling."}, "desc": "Schedule a shutdown. Requires explicit user confirmation."}, {"name": "system.cancel_shutdown", "params": {}, "desc": "Cancel a pending shutdown"}, {"name": "system.battery.status", "params": {}, "desc": "Speak current battery percentage and charging state"}, {"name": "system.wifi.status", "params": {}, "desc": "Speak current Wi-Fi connection status (SSID + on/off)"}, {"name": "clipboard.read", "params": {}, "desc": "Speak the current clipboard contents"}, {"name": "clipboard.write", "params": {"text": "string, what to copy"}, "desc": "Copy text to the clipboard"}, {"name": "note.add", "params": {"text": "string, the note body"}, "desc": "Append a quick note to ~/cozy_notes.md (read back with note.read)"}, {"name": "note.read", "params": {"limit": "int optional, default 5 (most recent N notes)"}, "desc": "Speak the most recent N notes"}, {"name": "calc.compute", "params": {"expression": "string, math expression e.g. '(2+3)*4'"}, "desc": "Evaluate a simple math expression and speak the result"}, {"name": "app.list_running", "params": {}, "desc": "List the apps currently open"}, {"name": "app.switch", "params": {"name": "string, app name or window title fragment"}, "desc": "Switch focus to an already-open app"}]}
{"messages": [{"role": "system", "content": "You are Cozy, a voice assistant running fully offline on the user laptop. Respond fast and short. When the user wants an action, call exactly one tool with compact JSON. For plain chat, answer briefly and warmly without tools."}, {"role": "user", "content": "Hi, I'm feeling a bit bored. Can you tell me something interesting?"}, {"role": "assistant", "content": "", "tool_calls": [{"type": "function", "function": {"name": "get_random_fact", "arguments": "{}"}}]}, {"role": "tool", "name": "get_random_fact", "content": "OK"}, {"role": "assistant", "content": "Done."}, {"role": "assistant", "content": "Did you know that an octopus has three hearts? Quite fascinating, isn't it?"}, {"role": "user", "content": "Wow, that's really interesting! Can you tell me another one?"}, {"role": "assistant", "content": "", "tool_calls": [{"type": "function", "function": {"name": "get_random_fact", "arguments": "{}"}}]}, {"role": "tool", "name": "get_random_fact", "content": "OK"}, {"role": "assistant", "content": "Done."}, {"role": "assistant", "content": "Here's another one for you. The Eiffel Tower can be 15 cm taller during the summer due to the expansion of the iron on hot days. Isn't that amazing?"}, {"role": "user", "content": "That's really cool! Thanks for sharing these facts with me."}], "tools": [{"name": "get_random_fact", "params": {}, "desc": "Get a random fact"}]}
