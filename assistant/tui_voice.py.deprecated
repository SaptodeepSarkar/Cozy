"""Cozy ambient voice TUI - shows wake/STT/LLM/TTS activity as a live log.

This is the default `cozy` (no args) experience. The TUI is just a
cleanly-formatted event log. No / commands (those need a keyboard;
use `cozy --text` for that).

Layout:
  - Top: one-line status bar (plugins loaded, last event time)
  - Body: scrolling event log of wake fires, STT transcriptions,
    LLM tool calls, TTS output
  - Bottom: empty (waiting for next event)

Voice loop runs in a background thread. Events are posted to a queue.
The main thread redraws the screen on each event.
"""
from __future__ import annotations

import sys
import threading
import time
import queue
from pathlib import Path
from typing import Any

# ANSI helpers
USE_COLOR = sys.stdout.isatty() and __import__("os").environ.get("NO_COLOR") is None
def _a(c): return f"\033[{c}m" if USE_COLOR else ""
def dim(s):   return _a("2") + s + _a("0")
def green(s): return _a("32") + s + _a("0")
def red(s):   return _a("31") + s + _a("0")
def yel(s):   return _a("33") + s + _a("0")
def cyan(s):  return _a("36") + s + _a("0")
def bold(s):  return _a("1") + s + _a("0")


def run_tui_voice(harness, threshold: float = 0.6) -> None:
    """Main entry: show status bar + event log while listening for audio."""
    # Lazy imports so this module can be loaded without audio deps
    from livekit.wakeword import WakeWordModel
    from stt import CozySTT
    from tts import is_available, speak

    # Load wake + STT (TTS loads lazily on first speak)
    WW_PATH = Path("/home/saptodeepsarkar/Projects/Cozy/wakeword/output/hey_cozy/hey_cozy.onnx")
    wake = WakeWordModel(models=[str(WW_PATH)])
    wake_name = next(iter(wake._classifiers.keys()))
    stt = CozySTT()

    # Print the initial banner + status
    print(bold("╭─ Cozy ambient voice ─╮"))
    print(f"  listening for '{wake_name}' (threshold {threshold})")
    print(f"  press Ctrl+C to exit")
    print(bold("╰────────────────────────╮"))
    print()

    # Event queue: wake -> STT -> LLM -> TTS
    event_q: queue.Queue = queue.Queue()
    last_event_time = [time.time()]
    stop_flag = [False]

    def emit(kind: str, **fields) -> None:
        event_q.put({"kind": kind, "ts": time.time(), **fields})
        last_event_time[0] = time.time()

    # Audio capture thread
    import sounddevice as sd
    import numpy as np
    SR = 16000
    CHUNK = 1280
    WIN = SR * 2
    audio_q: queue.Queue = queue.Queue()
    audio_buf = np.zeros(WIN, dtype=np.int16)
    audio_buf_fill = 0

    def audio_cb(indata, _f, _t, _s):
        audio_q.put(indata.copy())

    # Voice worker: read audio, score wake, capture command, run LLM
    def voice_worker():
        nonlocal audio_buf, audio_buf_fill
        import time as _t
        cooldown = 0.0
        with sd.InputStream(samplerate=SR, channels=1, dtype="int16",
                            blocksize=CHUNK, callback=audio_cb):
            while not stop_flag[0]:
                try:
                    chunk = audio_q.get(timeout=0.5)
                except queue.Empty:
                    continue
                chunk = chunk[:, 0].astype(np.int16)
                n = len(chunk)
                audio_buf = np.roll(audio_buf, -n)
                audio_buf[-n:] = chunk
                audio_buf_fill = min(WIN, audio_buf_fill + n)
                if audio_buf_fill < WIN:
                    continue
                if _t.time() < cooldown:
                    continue
                scores = wake.predict(audio_buf.copy())
                score = float(scores[wake_name])
                # Emit a wake score update every ~0.5s
                emit("wake_score", score=score, threshold=threshold)
                if score < threshold:
                    continue
                cooldown = _t.time() + 4.0
                emit("wake", score=score)
                # Capture 7s of command
                cmd_text = _capture_and_transcribe(stt, audio_buf, audio_q, audio_buf_fill, audio_buf)
                if not cmd_text:
                    emit("heard", text="(silence)")
                    continue
                emit("heard", text=cmd_text)
                # LLM
                t0 = _t.time()
                try:
                    name, args = harness.decide(cmd_text)
                except Exception as exc:
                    emit("error", msg=str(exc))
                    continue
                dt = _t.time() - t0
                if name:
                    emit("llm", tool=name, args=str(args)[:80], dt=dt)
                    from executor import execute
                    try:
                        result = execute(name, args or {})
                        ok = result.get("ok")
                        out = result.get("output", "")
                        emit("tool_result" if ok else "tool_fail", name=name, out=out[:300])
                    except Exception as exc:
                        emit("tool_error", name=name, msg=str(exc))
                        continue
                    # Speak the result
                    if is_available():
                        from tts import speak as _speak
                        _speak(out)
                        emit("tts", text=out[:120])
                else:
                    # Plain text reply - read from last assistant turn
                    for t in reversed(harness.trace.recent):
                        if t.role == "assistant" and t.content:
                            emit("llm_text", text=t.content, dt=dt)
                            if is_available():
                                from tts import speak as _speak
                                _speak(t.content)
                                emit("tts", text=t.content[:120])
                            break
                # Reset audio buffer
                audio_buf[:] = 0
                audio_buf_fill = 0

    def _capture_and_transcribe(stt, audio_buf, audio_q, audio_buf_fill, ref_buf):
        """Capture 7s of audio after wake, transcribe, return text."""
        import numpy as np
        import soundfile as sf
        from pathlib import Path
        frames = [ref_buf.copy()]
        silent_for = 0.0
        spoken = False
        t0 = time.time()
        while time.time() - t0 < 7.0:
            try:
                chunk = audio_q.get(timeout=0.05)
            except queue.Empty:
                chunk = None
            if chunk is not None:
                pcm = chunk[:, 0]
                frames.append(pcm.copy())
                level = float(np.abs(pcm).mean())
                if level > 300:
                    spoken = True
                    silent_for = 0.0
                elif spoken:
                    silent_for += len(pcm) / 16000
            if spoken and silent_for >= 1.1:
                break
        pcm = np.concatenate(frames) if len(frames) > 1 else np.zeros(16000, np.int16)
        tmp = Path("/tmp/cozy_cmd.wav")
        import soundfile as sf
        sf.write(str(tmp), pcm, 16000, subtype="PCM_16")
        try:
            text = stt.transcribe_file(str(tmp))
            return (text or "").strip()
        except Exception as exc:
            return f"(stt error: {exc})"

    # Start voice worker
    t = threading.Thread(target=voice_worker, daemon=True)
    t.start()

    # Main loop: redraw on each event
    last_status = ""
    try:
        while True:
            try:
                ev = event_q.get(timeout=0.2)
            except queue.Empty:
                # Just redraw the status bar with the elapsed-since-last-event
                age = time.time() - last_event_time[0]
                if age > 1.0:
                    msg = f"  {dim('idle')} ({age:.1f}s since last event)"
                    if msg != last_status:
                        sys.stdout.write("\r" + msg + " " * 20)
                        sys.stdout.flush()
                        last_status = msg
                continue
            last_status = ""
            # Print the event
            kind = ev.get("kind", "?")
            ts = ev.get("ts", 0)
            tstr = time.strftime("%H:%M:%S", time.localtime(ts))
            if kind == "wake_score":
                score = ev.get("score", 0)
                thr = ev.get("threshold", 0.5)
                bar = "#" * int(min(score, 1.0) * 30)
                fired = yel(" WAKE") if score >= thr else ""
                sys.stdout.write(f"\r  {dim(tstr)}  {cyan(bar.ljust(30))}  {score:.2f} / {thr}{fired}  ")
                sys.stdout.flush()
            elif kind == "wake":
                print(f"\n  {yel(tstr)}  {bold('WAKE')}  score={ev.get('score'):.2f}")
            elif kind == "heard":
                print(f"  {dim(tstr)}  {cyan('heard:')} {ev.get('text')}")
            elif kind == "llm":
                dt_str = str(ev.get('dt', 0))[:5]
                print(f"  {dim(tstr)}  {green('llm:')} {ev.get('tool')}({ev.get('args')})  {dim(dt_str + 's')}")
            elif kind == "llm_text":
                print(f"  {dim(tstr)}  {green('llm:')} {ev.get('text')[:200]}")
            elif kind in ("tool_result", "tool_fail"):
                color = green if kind == "tool_result" else red
                print(f"  {dim(tstr)}  {color(ev.get('name'))} -> {ev.get('out')[:200]}")
            elif kind == "tool_error":
                print(f"  {dim(tstr)}  {red('tool error:')} {ev.get('name')} - {ev.get('msg')}")
            elif kind == "tts":
                print(f"  {dim(tstr)}  {cyan('tts:')} {ev.get('text')[:100]}")
            elif kind == "error":
                print(f"  {dim(tstr)}  {red('error:')} {ev.get('msg')}")
    except KeyboardInterrupt:
        print()
        print(dim("shutting down..."))
        stop_flag[0] = True
        t.join(timeout=2.0)
        print(dim("bye."))
