# Optional shell function. Source this file from your bash/zsh rc to use cozy.
if [ -n "${BASH_VERSION:-}" ]; then
  _cozy_shell_src="${BASH_SOURCE[0]}"
else
  _cozy_shell_src="${(%):-%x}"
fi
COZY_ROOT="$(cd "$(dirname "$(realpath "$_cozy_shell_src")")" && pwd)"
unset _cozy_shell_src

cozy() { "$COZY_ROOT/cozy" "$@"; }
cozystatus() { "$COZY_ROOT/cozy" --status; }

if [ -n "${BASH_VERSION:-}" ]; then
  complete -W '--desktop --cli --status --help' cozy
elif [ -n "${ZSH_VERSION:-}" ] && type compdef >/dev/null 2>&1; then
  compdef '_arguments "--desktop" "--cli" "--status" "--help"' cozy
fi
