# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments (all three venvs)
.venv/
assistant/.venv/
stt-finetune/.venv/
wakeword/.venv/

# Heavyweight working data (downloads, synthetic bulk audio, caches)
wakeword/work/
wakeword/data/   # downloaded by livekit-wakeword setup (~5 GB)
wakeword/.venv/

# OS noise
.DS_Store
Thumbs.db

# Model weights (kept out of git, regenerated/fetched separately)
assistant/model/**/*.safetensors
assistant/model/**/*.bin
assistant/model/**/consolidated.safetensors
assistant/sft_log.txt
# Merged model output (kept out, regenerated by sft_qwen.py)
assistant/model/cozy-llm-v1/model.safetensors
# Adapter checkpoints
adapter_model.safetensors
# DPO adapter
cozy-llm-v1-dpo/adapter_model.safetensors

# RLM harness state (generated at runtime, regenerable)
assistant/data/harness/
assistant/data/rlm_children/
# Glaive dataset (downloaded by data prep scripts)
assistant/data/hf_glaive/

# Local override with real API keys
.mcp.json.local

# cozy-vision: regenerable artifacts (re-runnable via run.sh / setup.sh)
cozy-vision/data/screenshots/
cozy-vision/checkpoints/
cozy-vision/datasets/
cozy-vision/models/
